# Copy this file to .env and fill in real values. Never commit .env.

# GitHub personal access token (needs at minimum public_repo scope; use repo scope if you
# want to analyze private repositories you have access to). Without this set, the app still
# works against public repos, but at GitHub's much lower unauthenticated rate limit (60/hr
# instead of 5000/hr).
GITHUB_TOKEN=

# MongoDB connection string. Works with a local mongod (mongodb://127.0.0.1:27017/ai_pr_analyzer)
# or a MongoDB Atlas cluster (mongodb+srv://<user>:<password>@<cluster>/ai_pr_analyzer).
MONGODB_URI=

# Ollama model to use for summaries/quality notes. Must already be pulled (`ollama pull <name>`).
OLLAMA_MODEL=llama3.2:3b

# Shared secret for POST /api/analyze. Leave empty to disable auth (fine for loopback-only
# development — the server logs a warning). Set it before exposing the server beyond
# localhost: that endpoint spends your GitHub quota, drives local GPU work, and writes to
# your database. Clients then send it as an `x-api-key` header.
API_KEY=

# --- Optional overrides (sensible defaults are baked into src/config/index.js) ---
# PORT=5001
# HOST=127.0.0.1                       # set to 0.0.0.0 to expose off-box (set API_KEY too)
# GITHUB_API_BASE_URL=https://api.github.com   # override for GitHub Enterprise
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=4096
# OLLAMA_TIMEOUT_MS=45000
# MAX_COMMITS_PER_RUN=10
# MAX_PRS_PER_RUN=10
# MAX_ITEMS_PER_RUN_HARD_CAP=25        # ceiling on caller-supplied commitLimit/prLimit
# MAX_FILES_PER_ITEM=300               # file objects fetched per commit/PR
